{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/link-hub/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|onClick|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, onClick, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|cta|href|variant|soon|key|ref|className|style|children)$/]",
        "message": "<LinkCard> doesn't accept that prop. Declared props: title, description, cta, href, variant, soon."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:terracotta|olive|pink|white)$/]",
        "message": "<LinkCard> variant must be one of 'terracotta' | 'olive' | 'pink' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:withWordmark|src|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: withWordmark, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='MarqueeBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|key|ref|className|style|children)$/]",
        "message": "<MarqueeBanner> doesn't accept that prop. Declared props: items."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsletterForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:action|onSubmit|sent|key|ref|className|style|children)$/]",
        "message": "<NewsletterForm> doesn't accept that prop. Declared props: action, onSubmit, sent."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialIconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|icon|key|ref|className|style|children)$/]",
        "message": "<SocialIconButton> doesn't accept that prop. Declared props: label, href, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialIconButton'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:instagram|tiktok|linkedin)$/]",
        "message": "<SocialIconButton> icon must be one of 'instagram' | 'tiktok' | 'linkedin'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Badge": {
        "replaces": []
      },
      "Button": {
        "replaces": []
      },
      "LinkCard": {
        "replaces": []
      },
      "Logo": {
        "replaces": []
      },
      "MarqueeBanner": {
        "replaces": []
      },
      "NewsletterForm": {
